<?xml version="1.0" encoding="utf-8"?>
<!--
     权限清单只留真正用到的四个：没有 INTERNET（头像/贴纸图由宿主从抖音缓存读出来后推过来），
     没有 SYSTEM_ALERT_WINDOW（定时唤醒走 root + monkey；设置页的「悬浮引导」是
     PopupWindow，不需要该权限），也没有 READ/WRITE_EXTERNAL_STORAGE
     （配置在 App 私有目录，跨进程走 ConfigProvider）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 定时唤醒：到点拉起抖音。精确闹钟（Android 12+ 需单独授权，未授权时自动退化） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 定时唤醒：重启后重排闹钟（否则关机一次就再也不响了） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 定时唤醒：点亮屏幕（部分 ROM 上后台 Activity 需要） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:description="@string/spark_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/spark_name">

        <!-- 配置跨进程通道：管理界面（模块进程）写，宿主（抖音进程）读 -->
        <provider
            android:name=".app.provider.ConfigProvider"
            android:authorities="io.github.tiantong007.douyinspark.config"
            android:exported="true" />

        <!-- 宿主写配置前先唤醒本模块进程（见 WakeReceiver 注释），否则 provider 调不到 -->
        <receiver
            android:name=".app.provider.WakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.worldmargin.autospark.action.WAKE" />
            </intent-filter>
        </receiver>

        <!-- 定时唤醒：AlarmManager 到点叫醒本进程，拉起抖音并重排下一天 -->
        <receiver
            android:name=".app.alarm.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.worldmargin.autospark.action.DAILY_ALARM" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
             续火花管理界面：桌面图标入口 + 抖音设置页注入口（由抖音进程唤起，故需 exported）。

             excludeFromRecents + taskAffinity="" ：不进「最近任务」列表。因为任务卡片里
             上滑会被 MIUI 当成 SwipeUpClean，会连带清掉本 App 的闹钟（→ 定时唤醒彻底失效），
             所以让它压根不出现在那里。需要打开时走桌面图标或抖音设置页入口。
        -->
        <activity
            android:name=".app.ui.settings.SparkSettingsActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/spark_name"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.ui.template.TemplateEditActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 模板变量：一行一个（名字 + 两三行高的小 Monaco），结果回传给模板编辑页 -->
        <activity
            android:name=".app.ui.variable.VariableListActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.ui.conversation.ConversationEditActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 会话选择页：搜索 + 三页筛选 + 多选 -->
        <activity
            android:name=".app.ui.conversation.ConversationPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".app.ui.settings.DocsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 分段预览：把一段脚本按「会发出几条」画成气泡（不发送） -->
        <activity
            android:name=".app.ui.settings.PreviewActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>